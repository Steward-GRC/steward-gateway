# Local development settings. Copy to .env (git-ignored).
#
# Local dev logs everything in human-readable form. Cluster environments set
# their own level and always log JSON: dev cluster debug, qa/staging info,
# production error.
LOG_LEVEL=trace
LOG_FORMAT=console

GATEWAY_HTTP_ADDR=:8080
# No projected token on a laptop; never set this in a cluster.
WORKLOAD_AUTH=disabled
COOKIE_INSECURE=true
ALLOWED_ORIGINS=http://localhost:5173

VALKEY_ADDR=localhost:6379
# Live updates, AI job results and act-as audit events; empty turns them off.
RABBITMQ_URL=
KRATOS_PUBLIC_URL=http://localhost:4433
KRATOS_ADMIN_URL=http://localhost:4434

STEWARD_IDENTITY_ADDR=localhost:9091
STEWARD_CORE_ADDR=localhost:9092
STEWARD_WORKFLOW_ADDR=localhost:9093
STEWARD_OBLIGATIONS_ADDR=localhost:9094
STEWARD_AUDIT_ADDR=localhost:9095
STEWARD_DELIVERY_ADDR=localhost:9096
STEWARD_COLLAB_ADDR=localhost:9097
STEWARD_AI_ADDR=localhost:9098
STEWARD_REPORTING_ADDR=localhost:9099
COLLAB_WS_UPSTREAM=localhost:8081

# SSO through Polis (all three, or none).
POLIS_PUBLIC_URL=
POLIS_ISSUER_URL=
SSO_REDIRECT_BASE=

SETUP_TOKEN=
REPORT_PROBLEM_URL=
