extend type Query {

  # Categories
  category(id: ID!): Category
  categoryChildren(parentId: ID): [Category!]!
  # The whole subtree under rootId (including rootId itself), or the whole
  # category forest when rootId is omitted. Categories are at most three
  # levels deep, so this is always a small, one-call read.
  categoryTree(rootId: ID): [Category!]!
  # How many live documents the category itself holds (published and draft, retired
  # ones left out, descendants not counted), by kind. Site admin only. The settings
  # form reads it before it narrows documentTypes, to say how many would be stranded.
  categoryDocumentCounts(categoryId: ID!): CategoryDocumentCounts!

  # Templates
  templates(ownerCategoryId: ID): [Template!]!
  latestTemplateVersion(templateId: ID!): TemplateVersion
  # All versions of a template (newest first), incl. drafts — admin authoring.
  templateVersions(templateId: ID!): [TemplateVersion!]!

  # Policies
  policy(id: ID!): Policy
  # Looks a policy up by its rendered number (e.g. "POL-SAFETY-000007"), which
  # is unique by construction. Same read model and NotFound behavior as policy(id).
  policyByNumber(number: String!): Policy
  # documentType filters by kind: null lists policies only; POLICY or PROCEDURE
  # filters to that kind.
  policies(categoryId: ID!, includeDescendants: Boolean, documentType: DocumentType): [Policy!]!
  policyVersion(id: ID!): PolicyVersion
  policyVersions(policyId: ID!): [PolicyVersion!]!   # published versions, oldest-first
  diffVersions(fromVersionId: ID!, toVersionId: ID!): [SectionDiff!]!
  effectiveTemplate(policyId: ID!): EffectiveTemplate
}

extend type Mutation {
  # Categories
  createCategory(name: String!, slug: String!, parentId: ID): Category!
  # Template tri-state: pass defaultTemplateNone=true to set the category's default
  # template to explicit NONE (freeform); defaultTemplateId is then ignored.
  # defaultTemplateNone=false with a defaultTemplateId sets that specific
  # template; false with a null id means inherit from the ancestor chain.
  setCategoryDefaults(id: ID!, defaultTemplateId: ID, defaultWorkflowId: ID, defaultTemplateNone: Boolean): Category!
  # Lock or unlock the category's default template (site admin only). While locked,
  # a document under the category, or under one that inherits its template, must use
  # that template: createPolicy and setPolicyTemplate refuse freeform and any other
  # template, though asking for none (inherit) is still allowed. Locking is refused
  # (FAILED_PRECONDITION, TEMPLATE_LOCK_NEEDS_DEFAULT) while the category names no
  # default template. Core's refusals reach the client as extensions code
  # CATEGORY_TEMPLATE_LOCKED (4004) and TEMPLATE_LOCK_NEEDS_DEFAULT (4005).
  setCategoryTemplateLock(id: ID!, locked: Boolean!): Category!
  # Set which document types the category takes (site admin only). Widening always
  # works. Narrowing is refused (FAILED_PRECONDITION) while the category holds live
  # documents it would no longer accept: extensions code CATEGORY_HOLDS_DOCUMENTS
  # (4008) with count, policies and procedures as strings, so the form can link to a
  # bulk move. createPolicy and movePolicy refuse a type the category does not take
  # with extensions code CATEGORY_REFUSES_TYPE (4007).
  setCategoryDocumentTypes(id: ID!, documentTypes: CategoryDocumentTypes!): Category!
  # Rename a category (name + slug). Does NOT renumber existing policies.
  renameCategory(id: ID!, name: String!, slug: String!): Category!
  # Delete a category and its policy-free descendants. Refused
  # (FAILED_PRECONDITION) when the category or any descendant owns policies.
  deleteCategory(id: ID!): Boolean!
  # Move a category (and its whole descendant subtree) under a new parent.
  # A null newParentId promotes the category to a root (top-level). Re-parents
  # only the category: policies keep their home category and effective governance
  # is computed live from the ancestor chain, so there is no per-policy rewrite.
  # Refused (FAILED_PRECONDITION) when the move would exceed max depth 3 or create
  # a cycle (moving a category under itself or one of its descendants); nothing is
  # applied on failure.
  moveCategory(categoryId: ID!, newParentId: ID): Category!
  # Set the order of one parent's children (parentId null = the top level).
  # orderedIds must list every child of that parent exactly once, else
  # INVALID_ARGUMENT and nothing changes. Returns the children in the new
  # order. A new category, and one moved by moveCategory, goes last.
  reorderCategories(parentId: ID, orderedIds: [ID!]!): [Category!]!

  # Templates
  createTemplate(name: String!, ownerCategoryId: ID): Template!
  createTemplateVersion(templateId: ID!, sections: [SectionInput!]!): TemplateVersion!
  # Save edits to a draft version's sections (the authoring "Save"). Published
  # versions are immutable.
  updateTemplateVersionSections(id: ID!, sections: [SectionInput!]!): TemplateVersion!
  publishTemplateVersion(id: ID!): TemplateVersion!
  # Discard (delete) a draft version. Published versions can't be discarded.
  discardTemplateVersion(id: ID!): Boolean!
  # Retire (soft-delete): hides the template from listings/pickers but keeps
  # its versions so policies that pinned them keep working.
  retireTemplate(id: ID!): Template!
  # Hard-delete (dev-only, server-gated): physically removes an UNREFERENCED
  # template. Fails if any policy references it — retire those instead.
  deleteTemplate(id: ID!): Boolean!
  # Rename a template's display name. Template-level, NON-VERSIONED (like
  # renameCategory): does NOT create a new template version — the version list and
  # count are unchanged. Templates have no slug, so this is name-only.
  renameTemplate(id: ID!, name: String!): Template!

  # Policies
  # The owner/actor user is the signed-in user, never taken from input.
  # documentType is OPTIONAL: null => POLICY.
  createPolicy(homeCategoryId: ID!, title: String!, sensitivity: Sensitivity!, templateId: ID, documentType: DocumentType): Policy!
  # templateVersionId is OPTIONAL: pass null or "" for a freeform (no-template)
  # draft — the draft is saved with no pinned template version and template/
  # section validation is skipped. A non-null id pins that template version and
  # validates content against it.
  saveDraft(policyId: ID!, contentJson: String!, templateVersionId: ID): PolicyVersion!
  # setPolicyTemplate sets the policy-level template tri-state override. none=true
  # → explicit NONE (freeform), templateId ignored; none=false with a templateId
  # → that specific template; none=false with null templateId → inherit from the
  # owning category chain.
  setPolicyTemplate(policyId: ID!, templateId: ID, none: Boolean!): Policy!
  # publishDraft cuts the policy's working draft as a published version. Gated
  # on the effective-author model, like saveDraft. The order is:
  #   1. flush: collab persists the live editing room's newest checkpoint to
  #      core, so the version is not cut from content older than the room
  #      holds. No live room is the normal case and is not an error.
  #   2. publish: core cuts the version.
  #   3. freeze: collab drops the live room to read-only. Best effort; a
  #      failure here never fails the mutation, because core has committed.
  # Any flush failure stops the mutation before core publishes, with a coded
  # error (extensions.code / codeNum / domain "gateway" / kind):
  #   COLLAB_FLUSH_UNAVAILABLE (1242, kind reach): collab or core could not be
  #     reached in time. Retrying is safe; the message says so.
  #   COLLAB_FLUSH_REJECTED (1243, kind business): core refused the room's
  #     content, or the room belongs to another policy. extensions.reason
  #     carries the refusal, which the message also includes.
  #   COLLAB_FLUSH_FAILED (1244, kind reach): any other collab failure.
  # With no collab configured the flush and the freeze are both skipped.
  publishDraft(policyId: ID!): PolicyVersion!
  # Discard (delete) a policy's working draft. Only the draft is removed — the
  # policy and any published versions are untouched. A draft that is in review
  # has its open approval run withdrawn first (as the mock server ends it), so
  # no approver keeps a task on it; if the run can't be withdrawn the draft is
  # kept and the error is returned.
  discardDraft(policyId: ID!): Boolean!
  # Hard-delete a never-published policy (site-admin/category-author). Removes
  # the policy, its draft, and any appendices. Refused if ever published.
  deletePolicy(id: ID!): Boolean!
  # Retire (soft-delete) a policy: hides it from listings and cancels outstanding
  # ack obligations while KEEPING published-version history and completed acks.
  # Works on a published policy (unlike deletePolicy). Authorized at the SAME
  # effective-author tier as saveDraft/discardDraft/deletePolicy (site-admin,
  # primary author, or a non-denied category author).
  retirePolicy(id: ID!): Policy!
  # Site-admin: reassign a policy's owner (author).
  setPolicyOwner(policyId: ID!, ownerUserId: ID!): Policy!
  # Move a policy to another section; renumbers to the target's sequence. Needs Manage on
  # the policy's category and Author on the target, or the site-admin role.
  movePolicy(policyId: ID!, homeCategoryId: ID!): Policy!
  # Flip a policy's classification (STANDARD <-> SENSITIVE) in place. This is a
  # direct metadata change — it does NOT create a new version and does NOT trigger
  # the approval workflow. Allowed for any user with edit access to the policy.
  setPolicySensitivity(policyId: ID!, sensitivity: Sensitivity!): Policy!
  # Rename a policy. A never-published policy is renamed in place immediately
  # (staged=false). For a published policy the new title is staged on a draft
  # version and takes effect only when that draft is submitted for approval and
  # published (staged=true, draftVersionId set) — it is NOT auto-submitted.
  # Allowed for any user with edit access to the policy.
  renamePolicy(policyId: ID!, newTitle: String!): RenamePolicyResult!

  # Break-glass: a site-admin requests a time-boxed, audited reveal of a policy
  # whose content they would otherwise see obfuscated (excluded from it).
  # A non-empty reason is required. The grant flips subsequent reads to real
  # content until grantedUntil.
  breakGlassReveal(policyId: ID!, reason: String!): BreakGlassResult!

  # Site-admin: re-index a policy's current published version into the AI search
  # corpus. A first-class backend re-index trigger: it re-runs section
  # extraction through the current extractor and re-emits ONLY to the AI indexer
  # — it does NOT re-send the compliance review email. Audited as policy.reindexed.
  reindexPolicy(policyId: ID!): ReindexResult!
  # Site-admin: re-index a specific published policy version. Rejects drafts and
  # superseded versions. Same AI-only re-index as reindexPolicy.
  reindexPolicyVersion(policyVersionId: ID!): ReindexResult!
}

# ReindexResult reports what an admin re-index queued: the version re-indexed,
# how many section texts were emitted, and how many prior (superseded) versions'
# chunks were purged so exactly the current published version stays searchable.
type ReindexResult {
  versionId: ID!
  sections: Int!
  removedPrior: Int!
}



enum Sensitivity { STANDARD SENSITIVE }

# Policy vs procedure discriminator. Procedures are excluded from the
# ack pipeline; otherwise they share the policies surface and lifecycle.
enum DocumentType { POLICY PROCEDURE }

# What a category takes: both (the default), policies only, procedures only, or none
# (a container that holds only child categories).
enum CategoryDocumentTypes { BOTH POLICIES PROCEDURES NONE }

type CategoryDocumentCounts {
  policies: Int!
  procedures: Int!
}

enum AckTrigger { NONE ON_PUBLISH ON_CHANGE }
enum ReviewCadence { NONE ANNUAL BIENNIAL ON_DATE }

type Category {
  id: ID!
  name: String!
  slug: String!
  parentId: ID
  # Template tri-state. defaultTemplateNone=true → explicit NONE (freeform),
  # stop inheritance; defaultTemplateId set → that specific template;
  # both unset (none=false, id=null) → inherit from ancestor chain.
  defaultTemplateId: ID
  defaultTemplateNone: Boolean!
  # True when defaultTemplateId is binding: a document in this category, or in one
  # that inherits the template, must use it. Never true without a defaultTemplateId.
  defaultTemplateLocked: Boolean!
  # Which document types the category takes. The category's own setting; a child
  # does not inherit it. NONE makes it a container of child categories.
  documentTypes: CategoryDocumentTypes!
  defaultWorkflowId: ID
  owners: [ID!]!
  # Per-category ack-audience IdP group names. Empty list = "no audience"
  # (explicit override, treated as everyone by obligations). Not-set is null here
  # (inherit from ancestor). Parallels exclusionGroupIds semantics.
  idpGroupIds: [String!]
  ackTriggers: AckTrigger!
  reviewCadence: ReviewCadence!
  reviewDate: String
  # Per-category exclusion IdP group names. Empty list = "no exclusions" (explicit
  # override). Not-set is represented as null here (inherit from ancestor).
  exclusionGroupIds: [String!]
  # Ack-audience "Everyone" tri-state (parallels idpGroupIds nullability). When
  # the resolved value is true, every user must ack (the trigger still decides
  # WHETHER an ack is required). ackEveryoneSet=false means this category inherits
  # from its ancestor chain; true means it carries its own value.
  ackEveryone: Boolean!
  ackEveryoneSet: Boolean!
  # Position among the siblings under the same parent, from zero; lower comes
  # first. categoryChildren and categoryTree list siblings in this order. Gaps
  # are possible after a delete, so only the relative order counts.
  order: Int!
}

# EffectiveGovernance carries the inherited ack-audience and exclusion group
# names resolved by walking the ancestor chain with the leaf-wins rule. null
# means no category in the chain has set a value (i.e. "unset / inherit from
# system default", which obligations treats as everyone for audience and
# nobody for exclusions).
type EffectiveGovernance {
  ackAudienceGroups: [String!]
  exclusionGroups: [String!]
  # Resolved ack-audience "Everyone" flag after nearest-ancestor-wins
  # inheritance (false when no category in the chain sets it). When true, the ack
  # audience is ALL users and ackAudienceGroups is irrelevant.
  ackEveryone: Boolean!
}

type Template {
  id: ID!
  code: String!          # human-readable display code, TPL-NNN
  name: String!
  ownerCategoryId: ID
  retiredAt: String      # RFC3339; null = active. Set = retired (soft-deleted).
  # RFC3339. The latest of a rename and any version of the template being created or
  # published. Null when core has no time for it.
  updatedAt: String
}

# How big a change to a policy or template version is. It decides which part of the
# semantic version a publish raises: MAJOR raises the first number and resets the rest,
# MINOR raises the second and resets FIX, FIX raises the third.
enum ChangeType {
  MAJOR
  MINOR
  FIX
}

type TemplateVersion {
  id: ID!
  templateId: ID!
  # The ordinal (1, 2, 3 ...). The semantic version is semanticVersion.
  versionNo: Int!
  status: String!
  # MAJOR.MINOR.FIX, for example "2.1.0". Stored at publish (the first is 1.0.0); for a
  # draft it is the number a publish would give it now. Null only for a version that
  # core has no semantic version for.
  semanticVersion: String
  # What the version published as; for a draft, what it would publish as now. A required
  # section added, dropped or turned required is MAJOR; an optional section added or
  # dropped, or changed boilerplate text, is MINOR; the rest (titles, order, heading
  # level) is FIX. Null when unset.
  changeType: ChangeType
  createdAt: String      # RFC3339; null when unavailable
  publishedAt: String    # RFC3339; null until published
  sections: [Section!]!
}

type Section {
  key: String!
  title: String!
  order: Int!
  level: Int!          # heading depth H1-H5 (1-5)
  required: Boolean!   # must be filled before a policy can be submitted
  blocks: [Block!]!
}

type Block {
  type: String!
  contentJson: String
}

input SectionInput {
  key: String!
  title: String!
  order: Int!
  level: Int          # optional; defaults to 1 (H1) when omitted
  required: Boolean    # optional; defaults to false
  blocks: [BlockInput!]!
}

input BlockInput {
  type: String!
  contentJson: String
}

type Policy {
  id: ID!
  homeCategoryId: ID!
  number: String!
  title: String!
  sensitivity: Sensitivity!
  # Policy vs procedure. Non-null: UNSPECIFIED from core maps to POLICY.
  documentType: DocumentType!
  ownerUserId: ID!
  ownerName: String       # resolved from identity service; null when lookup unavailable
  createdAt: String       # RFC-3339 timestamp of first-version creation; null when unavailable
  updatedAt: String       # RFC-3339 timestamp of the last write to the policy row; null when unavailable
  currentPublishedVersionId: ID
  # Null for a viewer who can't edit, unless they hold a pending approval
  # seat on the draft; then they see it until they decide.
  currentDraftVersionId: ID
  # The version number/status of whichever version is current (published if
  # set, else the draft). Null when the policy has neither. versionNo is 0
  # for an unpublished draft, which isn't numbered until it's published.
  # currentVersionStatus is DRAFT, IN_REVIEW, REJECTED, PUBLISHED, SUPERSEDED
  # or ARCHIVED (REJECTED only when the latest version was turned down and
  # nothing is published).
  currentVersionNo: Int
  currentVersionStatus: String
  # Template tri-state. templateNone=true → explicit NONE (freeform), overrides
  # the category chain; templateId set → that specific template; both unset
  # (none=false, id=null) → inherit from the owning category chain.
  templateId: ID
  templateNone: Boolean!
  templateUpdateAvailable: Boolean!
  ackTriggers: AckTrigger      # null = inherit the owning category's
  ackAudienceOverride: [ID!]   # null = the owning category's audience
  viewerCan: PolicyViewerCan!  # per-viewer authorization decision (server-computed)
  retiredAt: String            # RFC3339; null = active. Set = retired (soft-deleted).
}

# PolicyViewerCan is the per-viewer authorization projection of a Policy,
# computed server-side from the permission catalog. The UI mirrors these for
# UX only; the gateway is the real enforcement boundary.
type PolicyViewerCan {
  read: Boolean!              # the viewer may see this policy at all
  edit: Boolean!             # the viewer may author/edit (scoped, in-category)
  submit: Boolean!           # the viewer may submit for approval (scoped)
  approve: Boolean!          # the viewer may approve (scoped)
  manage: Boolean!           # the viewer may move and reorder documents in this category (Manage, an owner or root)
  contentObfuscated: Boolean! # body is served obfuscated (excluded site admin)
  canBreakGlass: Boolean!    # the viewer may break-glass to reveal real content
  # breakGlassUntil: RFC 3339 instant at which the viewer's own active
  # break-glass grant on this policy ends; null when they hold none (never
  # granted, ended, or not a site admin). Only the caller's own grant is ever
  # reported. Lets the reader show "Revealed for you until ..." after a reload.
  breakGlassUntil: String
  # ack: true when the RACI chart places the viewer in this policy's ack
  # audience (ack rule match, merit-evaluated, read-gated; per-policy
  # override-allow uses the ungated ack match; override-deny → false).
  ack: Boolean!
}

# BreakGlassResult is returned by breakGlassReveal: the RFC-3339 instant until
# which the time-boxed reveal grant is active.
type BreakGlassResult {
  grantedUntil: String!
}

# RenamePolicyResult is returned by renamePolicy. staged=false means the new
# title was applied in place (never-published policy). staged=true means it was
# staged on a draft version (draftVersionId) awaiting submission + approval.
type RenamePolicyResult {
  policy: Policy!
  staged: Boolean!
  draftVersionId: ID
}

type PolicyVersion {
  id: ID!
  policyId: ID!
  versionNo: Int!
  # DRAFT, IN_REVIEW, REJECTED, PUBLISHED, SUPERSEDED or ARCHIVED. A version
  # that is not published (a draft, one in review, a rejected one) is read only
  # by an editor of the policy or the holder of a pending approval seat on it.
  status: String!
  templateVersionId: ID!
  contentJson: String!
  appendices: [Appendix!]!
  createdAt: String    # RFC-3339; null when unavailable
  publishedAt: String  # RFC-3339; null until published
  # MAJOR.MINOR.FIX, for example "2.1.0". Stored at publish; versionNo stays the ordinal.
  # For a draft or a version in review it is the number a publish would give it from its
  # content as it is now. Null for a version core has no semantic version for.
  semanticVersion: String
  # What core classified the change as against the version before. Null for the first
  # version, which is always 1.0.0.
  suggestedChangeType: ChangeType
  # The type the version publishes as: stored at publish; before that, the suggestion,
  # raised by the author's pick, and lowered below the suggestion only once the approvers
  # have agreed.
  changeType: ChangeType
  # A lowering below the suggestion that the author asked for and the approvers have not
  # yet agreed to. Null when there is none (it clears once the approvers agree).
  requestedChangeType: ChangeType
  # Why the author set the type below the suggestion.
  changeTypeReason: String
  # The user who picked the type; null when nobody did and the suggestion stands.
  changeTypeSetByUserId: ID
  # The approvers who agreed to a lowering. Empty when there was none.
  changeTypeAgreedByUserIds: [ID!]!
}

type Appendix {
  id: ID!
  policyVersionId: ID!
  title: String!
  contentJson: String!
  orderIndex: Int!
  letter: String!   # derived from orderIndex (A=0); single letter in v1
}

type SectionDiff {
  sectionKey: String!
  sectionTitle: String!
  changeType: String!
  wordDiffHtml: String
  isBoilerplate: Boolean!
}

type EffectiveTemplate {
  # none=true means the effective template resolved to explicit NONE (freeform):
  # templateId / templateVersionId are empty and the policy should be treated as
  # template-free rather than an error. The `effectiveTemplate` query returns a
  # value (not null) in this case, with none=true.
  templateId: ID!
  templateVersionId: ID!
  none: Boolean!
}

# --- Category governance + policy ack ---
extend type Query {
  """
  Returns the effective (inherited) ack-audience and exclusion groups for a
  category by applying the leaf-wins ancestor-chain rule. Use this for
  read-only display of inherited values and for the group picker affordance
  ("override" vs. "inherited from <ancestor>").
  """
  effectiveGovernance(categoryId: ID!): EffectiveGovernance!
}

extend type Mutation {
  """
  Persists governance fields on a category. idpGroupIds and exclusionGroupIds
  are IdP group names. Pass an empty list to explicitly set "no audience" /
  "no exclusions" (overriding any ancestor value); pass null (or omit) to leave
  the field unchanged so an inherited value is preserved. The stored
  per-category values (not the inherited effective values) are returned in the
  Category response. ackEveryone is tri-state like idpGroupIds: pass true/false
  to set this category's own value, pass null (or omit) to leave it inheriting
  from the ancestor chain.
  """
  setCategoryGovernance(id: ID!, owners: [ID!]!, idpGroupIds: [String!], exclusionGroupIds: [String!], ackTriggers: AckTrigger!, reviewCadence: ReviewCadence!, reviewDate: String, ackEveryone: Boolean): Category!
  setPolicyAck(policyId: ID!, ackTriggers: AckTrigger, ackAudienceOverride: [ID!]): Policy!
}


# --- Global settings (cross-app banners) ---
# Persisted server-side so a site admin's announcement and maintenance notice
# render as top banners in the web app. Backed by core SettingsService.
type Announcement {
  enabled: Boolean!
  level: String!
  message: String!
}

type Maintenance {
  enabled: Boolean!
  message: String!
}

type GlobalSettings {
  announcement: Announcement!
  maintenance: Maintenance!
  "The site work calendar. Always present: Monday to Friday, UTC, no holidays until a site admin sets one."
  workCalendar: WorkCalendar!
}

"""
The one site-wide calendar that says which days count as working days. A workflow
stage's slaDays is counted on it.
"""
type WorkCalendar {
  "ISO weekday numbers that are working days: 1 Monday to 7 Sunday."
  weekdays: [Int!]!
  "An IANA time zone name, for example Europe/London."
  timezone: String!
  "Dates that are not working days even when the weekday is."
  holidays: [Holiday!]!
}

type Holiday {
  "A real calendar date, YYYY-MM-DD."
  date: String!
  "A name for the day, 0 to 80 characters; it may be empty."
  label: String!
}

"""
The calendar to store. Core refuses an invalid one with InvalidArgument and the
code INVALID_WORK_CALENDAR: at least one weekday and no repeats, a known IANA
zone, real unique YYYY-MM-DD holiday dates (at most 366), labels of at most 80
characters.
"""
input WorkCalendarInput {
  weekdays: [Int!]!
  timezone: String!
  holidays: [HolidayInput!]!
}

input HolidayInput {
  date: String!
  label: String!
}

input AnnouncementInput {
  enabled: Boolean!
  level: String!
  message: String!
}

input MaintenanceInput {
  enabled: Boolean!
  message: String!
}

input GlobalSettingsInput {
  announcement: AnnouncementInput!
  maintenance: MaintenanceInput!
  "Omit to leave the stored calendar unchanged."
  workCalendar: WorkCalendarInput
}

# Readable by any signed-in user.
extend type Query { globalSettings: GlobalSettings! }

# Site-admin only.
extend type Mutation { setGlobalSettings(input: GlobalSettingsInput!): GlobalSettings! }

# --- Editor file settings (which kinds of file the File card accepts) ---
# Backed by core AssetService. All kinds are on by default; HTML, SVG, XML,
# scripts, executables, archives and macro-enabled Office files have no switch
# and are always refused.
"One switch of the setting: a kind of file the File card may accept."
type AssetKindSetting {
  "pdf, image, video, word, text, markdown or office."
  kind: String!
  label: String!
  "The extensions the kind covers, without the dot."
  extensions: [String!]!
  enabled: Boolean!
  "The hard size cap for the kind, in bytes."
  maxBytes: Int!
}

type AssetSettings {
  "Every kind that has a switch, in display order."
  kinds: [AssetKindSetting!]!
  "Extensions that are always refused and have no switch."
  refusedExtensions: [String!]!
  "The largest cap of any kind, in bytes (the upload limit)."
  maxFileBytes: Int!
  "The user id of the admin who last changed it; empty until first changed."
  updatedBy: String!
  "RFC 3339; empty until first changed."
  updatedAt: String!
}

extend type Query {
  "Readable by any signed-in user, so the editor can follow it."
  assetSettings: AssetSettings!
}

extend type Mutation {
  """
  Site-admin only. Replaces the set of allowed kinds; an empty list turns every
  kind off. An unknown kind is refused. Returns the settings now in force.
  """
  setAssetSettings(allowedKinds: [String!]!): AssetSettings!
}

# --- Email service configuration (site-admin) ---
# The sending configuration for the platform email transport, persisted
# server-side by core SettingsService. WRITE-ONLY credential:
# setEmailServiceConfig accepts the api key, but NO field ever returns it; the
# only thing this surface reveals about the key is apiKeySet (a presence flag).
type EmailServiceConfigStatus {
  """
  Whether a sending key is currently stored. The key's value is never returned
  by any query, only this presence flag, so the admin Settings page can show
  "a key is stored and not retrievable; you can only replace it" versus "no key
  set" without the value ever leaving core.
  """
  apiKeySet: Boolean!
  "The provider the configuration is for; empty until an admin sets one."
  provider: String!
  domain: String!
  region: String!
  fromAddress: String!
  enabled: Boolean!
}

input EmailServiceConfigInput {
  """
  WRITE-ONLY, presence-tracked. The sending api key. Stored server-side and
  never read back (see apiKeySet). Nullable so the field carries three states
  on save: omitted/null leaves the stored key unchanged (persist non-secret
  fields without re-sending the key); an empty string "" clears the stored key;
  a non-empty value sets it.
  """
  apiKey: String
  provider: String!
  domain: String!
  region: String!
  fromAddress: String!
  enabled: Boolean!
}

# Site-admin only. Presence + non-secret configuration view; never the key.
extend type Query { emailServiceConfig: EmailServiceConfigStatus! }

# Site-admin only. Stores the api key together with the non-secret config and
# returns the keyless status.
extend type Mutation { setEmailServiceConfig(input: EmailServiceConfigInput!): EmailServiceConfigStatus! }


# --- Appendices ---
extend type Mutation {
  addAppendix(policyVersionId: ID!, title: String!, contentJson: String!): Appendix!
  updateAppendix(id: ID!, title: String!, contentJson: String!): Appendix!
  reorderAppendices(policyVersionId: ID!, orderedIds: [ID!]!): [Appendix!]!
  deleteAppendix(id: ID!): Boolean!
}

# --- Related policies (structured links) ---
# Per-policy NON-VERSIONED structured links to other policies: stored
# one-way by id and resolved live to the related policy's number+title, so
# relationships are data rather than free text in the body. Editing them does
# not create a new policy version. setRelatedPolicies is a full replace.
type RelatedPolicy {
  policyId: ID!
  number: String!
  title: String!
}
extend type Query {
  relatedPolicies(policyId: ID!): [RelatedPolicy!]!
  # Policies eligible to be linked as related to the given policy.
  # A candidate B is offered only when every user who can READ the subject
  # policy can also read B (readers(subject) ⊆ readers(B)) — the same RACI read
  # decision + sensitivity gate the read model uses — so a link can never create
  # a dangling/leaky reference some of the subject's readers cannot follow. The
  # subject policy itself and policies the caller cannot see are excluded. This
  # is an advisory filter for the picker; setRelatedPolicies enforces the same
  # rule authoritatively.
  relatedPolicyCandidates(policyId: ID!): [Policy!]!
}
extend type Mutation {
  # A full replace of the policy's related-policy set. Rejected when any proposed
  # link violates the read-superset rule (readers(policyId) ⊆ readers(link));
  # see relatedPolicyCandidates.
  setRelatedPolicies(policyId: ID!, relatedPolicyIds: [ID!]!): [RelatedPolicy!]!
}

# --- Reusable contact blocks (library object) ---
# A reusable contact-information block defined once (admin-managed
# library) and referenced by many policies. A policy references blocks by id and
# renders them LIVE (track-latest): editing a block centrally updates every
# referencing policy. Attach/detach is a per-policy NON-VERSIONED change
# (setPolicyContactBlocks is a full replace). Only name is required.
type ContactBlock {
  id: ID!
  # label is the REQUIRED human name authors pick by; name/role are optional.
  label: String!
  name: String
  role: String
  department: String
  email: String
  phone: String
  hours: String
  notes: String
  # archived blocks drop out of the active library + author picker, but a
  # still-attached archived block keeps resolving live on existing policies.
  archived: Boolean!
  # number of policies referencing this block (read-only indicator).
  usedByCount: Int!
}
input ContactBlockInput {
  label: String!
  name: String
  role: String
  department: String
  email: String
  phone: String
  hours: String
  notes: String
}
extend type Query {
  # The reusable contact-block library (admin). Defaults to ACTIVE only; pass
  # includeArchived=true to include archived blocks.
  contactBlocks(includeArchived: Boolean): [ContactBlock!]!
  # The blocks attached to a policy, resolved live (incl. attached-but-archived).
  policyContactBlocks(policyId: ID!): [ContactBlock!]!
}
extend type Mutation {
  createContactBlock(block: ContactBlockInput!): ContactBlock!
  updateContactBlock(id: ID!, block: ContactBlockInput!): ContactBlock!
  deleteContactBlock(id: ID!): Boolean!
  # Archive (true) or restore (false) a library block.
  setContactBlockArchived(id: ID!, archived: Boolean!): ContactBlock!
  setPolicyContactBlocks(policyId: ID!, contactBlockIds: [ID!]!): [ContactBlock!]!
}

# --- References / Standards library (library object) ---
# A reusable References/Standards entry defined once (admin-managed
# library) and referenced by many policies, mirroring the reusable contact-block
# library above. A policy references entries by id and renders them LIVE
# (track-latest): editing an entry centrally updates every referencing policy.
# Attach/detach is a per-policy NON-VERSIONED change (setPolicyReferences is a
# full replace). Only label is required.
enum ReferenceKind { STANDARD TEXT LINK }
type Reference {
  id: ID!
  # label is the REQUIRED human name authors pick by.
  label: String!
  kind: ReferenceKind!
  # clause is an optional section/clause citation (e.g. "§4.2").
  clause: String
  # body is free text (TEXT kind); url is an external link (LINK kind).
  body: String
  url: String
  # archived entries drop out of the active library + author picker, but a
  # still-attached archived entry keeps resolving live on existing policies.
  archived: Boolean!
  createdByUserId: ID
  # number of policies referencing this entry (read-only indicator).
  usedByCount: Int!
}
input ReferenceInput {
  label: String!
  kind: ReferenceKind!
  clause: String
  body: String
  url: String
}
extend type Query {
  # The reusable references/standards library (admin). Defaults to ACTIVE only;
  # pass includeArchived=true to include archived entries.
  references(includeArchived: Boolean): [Reference!]!
  # The references attached to a policy, resolved live (incl. attached-but-archived).
  policyReferences(policyId: ID!): [Reference!]!
}
extend type Mutation {
  createReference(input: ReferenceInput!): Reference!
  updateReference(id: ID!, input: ReferenceInput!): Reference!
  deleteReference(id: ID!): Boolean!
  # Archive (true) or restore (false) a library entry.
  setReferenceArchived(id: ID!, archived: Boolean!): Reference!
  setPolicyReferences(policyId: ID!, referenceIds: [ID!]!): [Reference!]!
}

# --- Definitions library (category-scoped library object) ---
# A reusable, CATEGORY-SCOPED glossary entry defined once and attached
# by many policies, mirroring the References/Standards library above with one
# addition: a categoryId scope. A definition belongs to a category;
# the staff attach picker for a policy offers definitions whose categoryId is in
# that policy's ancestor chain (leaf -> root). A policy attaches entries by id
# and renders them LIVE (track-latest): editing an entry centrally updates every
# attaching policy. Attach/detach is a per-policy NON-VERSIONED change
# (setPolicyDefinitionEntries is a full replace). Definition text is PLAIN.
type DefinitionEntry {
  id: ID!
  # owning category, the sharing scope.
  categoryId: ID!
  term: String!
  definition: String!
  # archived entries drop out of the active library + author picker, but a
  # still-attached archived entry keeps resolving live on existing policies.
  archived: Boolean!
  createdByUserId: ID
  # number of policies attaching this entry (read-only indicator).
  usedByCount: Int!
}
input DefinitionEntryInput {
  # required on create, immutable on update.
  categoryId: ID!
  term: String!
  definition: String!
}
extend type Query {
  # The reusable definitions library (admin). categoryId (optional) scopes the
  # list to a single category; omit it for all categories. Defaults to ACTIVE
  # only; pass includeArchived=true to include archived entries.
  definitions(categoryId: ID, includeArchived: Boolean): [DefinitionEntry!]!
  # The definitions attachable to a policy: those whose category is in the
  # policy's ancestor chain (leaf -> root). Backs the staff attach picker.
  policyDefinitionCandidates(policyId: ID!, includeArchived: Boolean): [DefinitionEntry!]!
  # The definitions attached to a policy, resolved live (incl. attached-but-archived).
  policyDefinitionEntries(policyId: ID!): [DefinitionEntry!]!
}
extend type Mutation {
  createDefinition(input: DefinitionEntryInput!): DefinitionEntry!
  updateDefinition(id: ID!, input: DefinitionEntryInput!): DefinitionEntry!
  deleteDefinition(id: ID!): Boolean!
  # Archive (true) or restore (false) a library entry.
  setDefinitionArchived(id: ID!, archived: Boolean!): DefinitionEntry!
  setPolicyDefinitionEntries(policyId: ID!, definitionIds: [ID!]!): [DefinitionEntry!]!
}

# --- RACI category rulesets (decided by the go-authz ordered engine) ---
enum RaciGrant { BLANK ALLOW DENY }
enum RaciSubjectKind { EVERYONE GROUP USER }

# One row of a category's access rules: a subject and a cell per action. The
# decision is per action, read from the top: the first row that matches the
# person and has a non-blank cell for that action decides, then the parent
# category's rows. Manage lets a person move and reorder documents; it implies
# Read and Author only, and does not gate editing the rules or the governance
# (those stay global-admin only).
type RaciRule {
  subjectKind: RaciSubjectKind!
  subjectRef: String!
  read: RaciGrant!
  ack: RaciGrant!
  approve: RaciGrant!
  author: RaciGrant!
  manage: RaciGrant!
}
input RaciRuleInput {
  subjectKind: RaciSubjectKind!
  subjectRef: String!
  read: RaciGrant!
  ack: RaciGrant!
  approve: RaciGrant!
  author: RaciGrant!
  # Defaults to BLANK so a client that does not know Manage yet keeps working.
  manage: RaciGrant! = BLANK
}
type CategoryRuleset { categoryId: ID!  rules: [RaciRule!]! }

# Why one action was decided as it was, as a code the UI can switch on beside
# the human string. ENTRY: a row decided (directly or through a higher action).
# DEFAULT_DENY: no row decides. OWNER: an owner of the category or a parent.
# ROOT: the root seat. REQUIRES: a required action (Ack needs Read) is denied.
enum RaciReasonCode { ENTRY DEFAULT_DENY OWNER ROOT REQUIRES }
enum RaciAction { READ AUTHOR APPROVE MANAGE ACK }

# A deny of Read, Author or Manage that is configured for root: stored, never
# applied (root always holds those three), and shown by the simulator as
# blocked. A deny of Approve or Ack applies to root and is not listed.
type RaciConfiguredBlock {
  action: RaciAction!
  categoryId: ID!
  subjectKind: RaciSubjectKind!
  subjectRef: String!
}
type RaciDecision {
  read: Boolean!  ack: Boolean!  approve: Boolean!  author: Boolean!  manage: Boolean!
  readReason: String!  ackReason: String!  approveReason: String!  authorReason: String!  manageReason: String!
  readCode: RaciReasonCode!  ackCode: RaciReasonCode!  approveCode: RaciReasonCode!  authorCode: RaciReasonCode!  manageCode: RaciReasonCode!
  # Empty unless the person is root and a row would have denied Read, Author or Manage.
  configuredBlock: [RaciConfiguredBlock!]!
}
extend type Query {
  categoryRuleset(categoryId: ID!): CategoryRuleset!
  simulateCategory(categoryId: ID!, userId: ID!, draftRules: [RaciRuleInput!]): RaciDecision!
  categoryApprovers(categoryId: ID!): [User!]!
  """
  viewerIsApprover is true when the signed-in user holds RACI Approve in any
  category (rule-granted or owner); drives the staff Approvals-section eligibility.
  """
  viewerIsApprover: Boolean!
}
extend type Mutation {
  setCategoryRuleset(categoryId: ID!, rules: [RaciRuleInput!]!): CategoryRuleset!
}


