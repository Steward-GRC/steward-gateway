# --- Live updates: GraphQL subscriptions over websocket ---
type LiveEvent {
  type: String!        # audit action, e.g. "category.created", "policy.published"
  entityId: String     # subject, e.g. "category:<uuid>" / "policy_version:<uuid>"
  groupId: String
  actorUserId: String
  at: String!          # RFC3339 timestamp
}

extend type Subscription {
  # Streams domain-change events so clients can refetch affected data live.
  # `topics` filters by prefix on `type` (e.g. ["group.", "policy."]); omit or
  # pass empty for all events.
  liveEvents(topics: [String!]): LiveEvent!
}


